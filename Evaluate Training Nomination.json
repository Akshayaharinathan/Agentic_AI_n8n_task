    {
      "parameters": {
        "jsCode": "let score = 0;\n \nconst data = $input.first().json;\nconst emp = data.body;\nconst rule = data;\nlet decision=\"\";\nlet reason=\"\"\nconst rule_id=rule.rule_id\n \nif (emp.experience_years >= rule.min_experience_years) {\n  score += rule.experience_points;\n}\n \nlet matched = [];\nlet missing = [];\n \nconst skills = [\n  rule.required_skill_1,\n  rule.required_skill_2,\n  rule.required_skill_3\n];\nlet skill_set = skills.toString();\n \nfor (const s of skills) {\n  if (emp.current_skills.includes(s)) {\n    score += rule.skill_points_each;\n    matched.push(s);\n  } else {\n    missing.push(s);\n  }\n}\n\n\n \nif (emp.manager_approval) {\n  score += rule.manager_approval_points;\n}\n \nif (emp.business_justification) {\n  score += rule.justification_points;\n}\nif(score>70){\n  decision=\"Approved\"\n  reason=\"Score>70\"\n}\nelse if (score==70) {\n  decision=\"Waitlisted\"\n  reason=\"Score=70\"\n} else {\n  decision=\"Not Eligible\"\n  reason=\"Score<70\"\n  \n}\n \nreturn [{\n  json: {\n    ...emp,\n    rule_id,\n    skill_set,\n    score,\n    decision,\n    reason,\n    matched_skills: matched.toString(),\n    missing_skills: missing.toString()\n  }\n}];\n "
      },
